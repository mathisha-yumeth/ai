{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and AI preference settings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User identifier matching auth UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image URL",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of user creation",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 64
        },
        "selectedProvider": {
          "type": "string",
          "description": "Default local provider (webgpu, ollama, lmstudio, local_engine)",
          "maxLength": 64
        },
        "selectedModel": {
          "type": "string",
          "description": "Default local model name",
          "maxLength": 128
        }
      },
      "required": ["id", "email", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat session with a local LLM",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique session identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Session title",
          "maxLength": 256
        },
        "provider": {
          "type": "string",
          "description": "Local LLM runner provider",
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "description": "Model ID used for this chat",
          "maxLength": 128
        },
        "systemPrompt": {
          "type": "string",
          "description": "Custom system instructions",
          "maxLength": 8192
        },
        "temperature": {
          "type": "number",
          "description": "Sampling temperature"
        },
        "topP": {
          "type": "number",
          "description": "Top-p nucleus sampling"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Pinned to top of sidebar"
        },
        "messageCount": {
          "type": "number",
          "description": "Total message count"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "Last activity timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "title", "provider", "model", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message in a chat conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID",
          "maxLength": 128
        },
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Author UID",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Message role",
          "enum": ["user", "assistant", "system"],
          "maxLength": 32
        },
        "content": {
          "type": "string",
          "description": "Message textual payload",
          "maxLength": 65536
        },
        "modelUsed": {
          "type": "string",
          "description": "Model identifier that generated this response",
          "maxLength": 128
        },
        "tokensUsed": {
          "type": "number",
          "description": "Estimated tokens in response"
        },
        "durationMs": {
          "type": "number",
          "description": "Inference time in milliseconds"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "conversationId", "userId", "role", "content", "createdAt"]
    },
    "PromptPreset": {
      "title": "PromptPreset",
      "description": "Saved reusable system prompt or persona",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Preset ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Preset title",
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "description": "Category tag",
          "maxLength": 64
        },
        "systemPrompt": {
          "type": "string",
          "description": "System prompt body",
          "maxLength": 8192
        },
        "initialUserMessage": {
          "type": "string",
          "description": "Optional starting template message",
          "maxLength": 4096
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "title", "systemPrompt", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile and settings"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": {
        "$ref": "#/entities/Conversation"
      },
      "description": "User's local AI chat sessions"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Messages belonging to a conversation"
    },
    "/users/{userId}/promptPresets/{presetId}": {
      "schema": {
        "$ref": "#/entities/PromptPreset"
      },
      "description": "User's saved prompt templates"
    }
  }
}
